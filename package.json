{
  "name": "theaps",
  "version": "1.0.0",
  "description": "A simple Heap implementation in TypeScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tukajo/theaps.git"
  },
  "files": [
    "dist/**/*"
  ],
  "main": "dist/theaps.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc --emitDeclarationOnly && webpack --stats errors-warnings --mode=production",
    "build:dev": "npm run clean && tsc --emitDeclarationOnly && webpack --mode=development",
    "build:prod": "npm run clean && tsc --emitDeclarationOnly && webpack --mode=production",
    "devPack": "webpack --config webpack.config.js --mode=development",
    "lint": "eslint '*/**/*.{js,ts,tsx,jsx}' --quiet --fix",
    "test": "jest"
  },
  "jest": {
    "transform": {
      "^.+\\.[t|j]sx?$": "babel-jest"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.17.2",
    "@babel/node": "^7.16.8",
    "@babel/plugin-transform-runtime": "^7.17.0",
    "@babel/plugin-transform-typescript": "^7.10.4",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-typescript": "^7.16.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "lodash": "^4.17.21",
    "prettier": "^3.9.9",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.1.0",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^5.1.4"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
