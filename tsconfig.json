{
    "compilerOptions": {
        "declaration": true,
        "declarationDir": "./dist",
        "strict": true,
        "strictNullChecks": true,
        "noUnusedParameters": true,
        "noImplicitAny": true,
        "noImplicitThis": false,
        "noUnusedLocals": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2020",
        "sourceMap": true
    },
    "include": [
        "./src/**/*.ts",
        "./src/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.test.ts"
    ]
}